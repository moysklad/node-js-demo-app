<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Node Demo App iframe</title>
    <link rel="stylesheet" href="/assets/entry/iframe.css">
    <script defer src="/assets/entry/iframe.js"></script>
</head>
<body>
<nav class="tab-bar" role="tablist" aria-label="Разделы решения">
    <button class="tab-button is-active" type="button" role="tab" data-tab="main" aria-selected="true"
            aria-controls="tab-main">
        Основное
    </button>
    <button class="tab-button" type="button" role="tab" data-tab="loyalty" aria-selected="false"
            aria-controls="tab-loyalty">
        Программа лояльности
    </button>
</nav>

<section id="tab-main" class="tab-panel is-active" role="tabpanel">
    <main class="iframe-layout">
        <section class="panel">
            <h2>Информация о пользователе</h2>
            <ul class="info-list">
                <li>Текущий пользователь: <%= uid %> (<%= fio %>)</li>
                <li>Идентификатор аккаунта: <%= accountId %></li>
                <li>Уровень доступа: <b><%= isAdmin ? "администратор аккаунта" : "простой пользователь" %></b>
                </li>
            </ul>
            <div class="panel-divider"></div>
            <h2>Состояние решения</h2>
            <p class="app-version">Версия <%= appVersion %></p>
            <div id="appStatus" class="status-box <%= isSettingsRequired ? "status-required" : "status-ready" %>">
                <div id="appStatusTitle" class="status-title">
                    <%= isSettingsRequired ? "ТРЕБУЕТСЯ НАСТРОЙКА" : "РЕШЕНИЕ ГОТОВО К РАБОТЕ" %>
                </div>
                <% if (!isSettingsRequired) { %>
                    <p id="appStatusDetails">
                        Сообщение: <%= infoMessage %><br>
                        Выбран склад: <%= store %>
                    </p>
                <% } else { %>
                    <p id="appStatusDetails" hidden></p>
                <% } %>
            </div>
        </section>
        <section class="panel">
            <h2>Форма настроек</h2>
            <% if (isAdmin) { %>
                <form id="settingsForm" method="post" action="../utils/update-settings" data-update-url="/utils/update-settings">
                    <div class="row field-row">
                        <label for="infoMessage">Укажите сообщение</label>
                        <input id="infoMessage" type="text" name="infoMessage" value="<%= infoMessage ?? '' %>">
                    </div>
                    <div class="row field-row">
                        <label for="store">Выберите склад</label>
                        <select id="store" name="store">
                            <% if (store && !storesValues.includes(store)) { %>
                                <option value="<%= store %>" selected><%= store %></option>
                            <% } %>
                            <% for (const v of storesValues) { %>
                                <option value="<%= v %>" <%= v === store ? "selected" : "" %>><%= v %></option>
                            <% } %>
                        </select>
                    </div>
                    <input type="hidden" name="contextNonce" value="<%= contextNonce %>"/>
                    <button class="btn" type="submit">Сохранить</button>
                    <div id="settingsResult" class="form-result" role="status" aria-live="polite"></div>
                </form>
            <% } else { %>
                <p class="muted">Настройки доступны только администратору аккаунта</p>
            <% } %>
        </section>
        <section class="panel panel-wide">
            <h2>Проверка autoResizeIframe</h2>
            <p class="muted">
                Меняйте количество секций ниже. Если <code>autoResizeIframe()</code> работает корректно, высота iframe
                должна меняться без перезагрузки страницы.
            </p>
            <div class="btn-row">
                <button class="btn" type="button" id="btnDecreaseProbe">Уменьшить</button>
                <button class="btn" type="button" id="btnIncreaseProbe">Увеличить</button>
            </div>
            <p class="probe-counter">Количество секций: <span id="probeCount">1</span></p>
            <div id="resizeProbe" class="resize-probe"></div>
        </section>
    </main>
</section>

<section id="tab-loyalty" class="tab-panel" role="tabpanel" hidden>
    <main class="loyalty-layout">
        <section class="panel panel-wide">
            <h2>Состояние программы лояльности</h2>
            <p class="muted">
                Подключение программы лояльности необязательно и на статус решения не влияет: точку встраивания
                используют только вендоры программ лояльности.
            </p>
            <div id="loyaltyStatus" class="status-box <%= loyalty.className %>">
                <div id="loyaltyStatusTitle" class="status-title"><%= loyalty.title %></div>
                <p id="loyaltyStatusDetails"><%= loyalty.details %></p>
            </div>
        </section>

        <section class="card setup-intro panel-wide" id="exampleEntry">
            <p class="setup-intro__lead">
                Чтобы МойСклад мог обращаться к API программы лояльности, передайте адрес вашего API
                и токен доступа с помощью Vendor API.
            </p>

            <button
                class="request-toggle"
                id="requestToggle"
                type="button"
                aria-expanded="false"
                aria-controls="requestExample"
            >
                <span>Показать пример запроса</span>
                <span class="request-toggle__icon" aria-hidden="true">⌄</span>
            </button>

            <div class="request-example" id="requestExample" hidden>
                <pre>curl -X PUT \
"https://apps-api.moysklad.ru/api/vendor/1.0/apps/5f3c5489-6a17-48b7-9fe5-b2000eb807fe/f088b0a7-9490-4a57-b804-393163e7680f/loyalty" \
-H "Content-Type: application/json" \
-H "Accept: application/json" \
-H "Authorization: Bearer ..." \
-d '{
  "url": "https://...",
  "token": "...",
  "externalSearch": false
}'</pre>
            </div>

            <p class="setup-intro__text">
                Получить эти данные можно после идентификации пользователя по логину и паролю в программе лояльности — рекомендуем этот способ.
                Также допустимо предложить пользователю ввести адрес API, токен и указать режим внешнего поиска покупателей напрямую.
            </p>

            <div class="actions">
                <% if (isAdmin) { %>
                    <button class="button button--primary" id="showOnboarding" type="button">
                        Перейти к примерам реализации
                    </button>
                <% } else { %>
                    <p class="muted">Подключение программы лояльности доступно только администратору аккаунта</p>
                <% } %>
            </div>
        </section>

        <% if (isAdmin) { %>
        <section class="onboarding" id="onboarding" aria-hidden="true" hidden>
            <div class="onboarding__top">
                <button class="button button--ghost" id="hideOnboarding" type="button">
                    ← К описанию
                </button>
            </div>

            <section class="card">
                <div class="card__header">
                    <div>
                        <h2>Настройка через авторизацию или регистрацию</h2>
                        <p>
                            Пользователь входит в программу лояльности, а ее провайдер сам находит
                            настройки и передает их в МойСклад. Этот вариант подходит для непосредственных провайдеров программы лояльности.
                        </p>
                    </div>
                    <span class="badge">Рекомендованный способ</span>
                </div>

                <div class="actions">
                    <button class="button button--primary" id="openAuth" type="button">
                        Попробовать
                    </button>
                </div>
            </section>

            <section class="card">
                <div class="card__header">
                    <div>
                        <h2>Прямая передача настроек</h2>
                        <p>
                            Вы запрашиваете у пользователя URL, токен и режим внешнего поиска покупателей
                            напрямую. Этот вариант можно использовать, когда по логину и паролю невозможно получить настройки программы лояльности.
                        </p>
                    </div>
                    <span class="badge badge--secondary">Допустимый способ</span>
                </div>

                <div class="actions">
                    <button class="button button--secondary" id="openManual" type="button">
                        Попробовать
                    </button>
                </div>
            </section>
        </section>
        <% } %>
    </main>
</section>

<% if (isAdmin) { %>
<dialog id="authDialog" aria-labelledby="authTitle">
    <div class="modal">
        <div class="modal__top">
            <div>
                <h2 id="authTitle">Программа лояльности</h2>
                <p id="authSubtitle">
                    Войдите или зарегистрируйтесь, чтобы подключить аккаунт к МоемуСкладу.
                </p>
            </div>
            <button class="close" id="closeAuth" aria-label="Закрыть" type="button">×</button>
        </div>

        <form class="auth-form" id="authForm" autocomplete="off">
            <div class="tabs" role="tablist" aria-label="Способ авторизации">
                <button class="tab is-active" type="button" data-mode="login" role="tab">
                    Войти
                </button>
                <button class="tab" type="button" data-mode="register" role="tab">
                    Зарегистрироваться
                </button>
            </div>

            <div class="field">
                <label for="login">Логин</label>
                <input id="login" name="login" type="text" placeholder="login" autocomplete="off" spellcheck="false" required />
            </div>

            <div class="field">
                <label for="password">Пароль</label>
                <input
                    id="password"
                    name="password"
                    type="password"
                    placeholder="password"
                    autocomplete="off"
                    required
                />
            </div>

            <button class="button button--primary" id="authSubmit" type="submit">
                Войти и продолжить
            </button>
        </form>

        <section class="result" id="authResult" aria-live="polite">
            <div class="flow">
                <div class="flow__item">
                    <div class="flow__number">1</div>
                    <div>
                        <strong>Провайдер авторизует пользователя</strong>
                        <span id="identityText">
                            Программа лояльности получает login и password на своей стороне.
                        </span>
                    </div>
                </div>

                <div class="flow__item">
                    <div class="flow__number">2</div>
                    <div>
                        <strong>Провайдер находит настройки аккаунта</strong>
                        <span>
                            По учетной записи определяются baseURL, токен и режим внешнего поиска покупателей.
                        </span>
                    </div>
                </div>

                <div class="flow__item">
                    <div class="flow__number">3</div>
                    <div>
                        <strong>Провайдер передает настройки в МойСклад</strong>
                        <span>
                            Для передачи используется PUT-запрос.
                        </span>
                    </div>
                </div>
            </div>

            <pre>PUT https://apps-api.moysklad.ru/api/vendor/1.0/apps/{appId}/{accountId}/loyalty

{
  "url": "https://loyalty.example.com/api",
  "token": "generated-provider-token",
  "externalSearch": true
}</pre>

            <div class="actions">
                <button class="button button--primary" id="finishPreferred" type="button">
                    Завершить настройку
                </button>
                <button class="button button--ghost" id="backToAuth" type="button">
                    Назад
                </button>
            </div>
        </section>
    </div>
</dialog>

<dialog id="manualDialog" aria-labelledby="manualTitle">
    <div class="modal">
        <div class="modal__top">
            <div>
                <h2 id="manualTitle">Ручная настройка</h2>
                <p>
                    Запросите у пользователя адрес API, токен доступа и режим внешнего поиска покупателей.
                </p>
            </div>
            <button class="close" id="closeManual" aria-label="Закрыть" type="button">×</button>
        </div>

        <form id="manualForm">
            <div class="field">
                <label for="providerUrl">URL программы лояльности</label>
                <input
                    id="providerUrl"
                    name="providerUrl"
                    type="url"
                    placeholder="<%= defaultLoyaltyProviderUrl %>"
                    value="<%= defaultLoyaltyProviderUrl %>"
                    required
                />
                <div class="field__hint">
                    Base URL, по которому МойСклад будет обращаться к API программы лояльности.
                </div>
            </div>

            <div class="field">
                <label for="providerToken">Токен доступа</label>
                <input
                    id="providerToken"
                    name="providerToken"
                    type="password"
                    placeholder="token"
                    value="demo-token-123"
                    autocomplete="off"
                    spellcheck="false"
                    required
                />
                <div class="field__hint">
                    Токен, который МойСклад будет использовать при обращении к API.
                </div>
            </div>

            <div class="checkbox">
                <input id="externalSearch" name="externalSearch" type="checkbox" checked />
                <label for="externalSearch">
                    Использовать внешний поиск покупателей
                </label>
            </div>

            <input type="hidden" name="contextNonce" value="<%= contextNonce %>"/>

            <div class="actions">
                <button class="button button--primary" type="submit">
                    Сформировать настройки
                </button>
                <button class="button button--ghost" id="cancelManual" type="button">
                    Назад
                </button>
            </div>

            <div class="status" id="manualStatus" role="status"></div>
            <pre id="manualRequest" hidden></pre>

            <div class="actions" id="manualFinishActions" hidden>
                <button class="button button--primary" id="finishManual" type="button">
                    Завершить настройку
                </button>
            </div>
        </form>
    </div>
</dialog>
<% } %>
</body>
</html>
