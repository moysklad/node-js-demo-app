{
  "name": "node-js-demo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js/TypeScript demo marketplace app for MoySklad",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "npm run typecheck",
    "clean:data": "rm -rf tmp/data && mkdir -p tmp/data/sessions && chmod 700 tmp/data tmp/data/sessions"
  },
  "dependencies": {
    "axios": "1.15.2",
    "dotenv": "17.4.2",
    "ejs": "5.0.2",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "jsonwebtoken": "9.0.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.6.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
