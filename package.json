{
  "name": "node-js-demo-app",
  "version": "1.3.0",
  "private": true,
  "description": "Node.js/TypeScript demo marketplace app for MoySklad",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:assets",
    "dev:server": "tsx watch src/server.ts",
    "dev:assets": "node scripts/build-client-assets.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json && npm run build:assets",
    "build:assets": "node scripts/build-client-assets.mjs && mkdir -p dist && rm -rf dist/public && mkdir -p dist/public/assets && cp -R public/assets/entry dist/public/assets/entry && cp -R public/assets/fonts dist/public/assets/fonts",
    "start": "node dist/server.js",
    "cli:generate-jwt": "tsx src/cli-utils/generate-jwt.ts",
    "cli:generate-descriptor": "tsx src/cli-utils/generate-descriptor.ts",
    "test": "tsx --test tests/*.test.ts tests/**/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:test && npm test",
    "clean:data": "rimraf tmp/data && shx mkdir -p tmp/data && shx chmod 700 tmp/data"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@moysklad/js-widget-sdk": "1.1.0",
    "@moysklad/uikit": "30.4.0",
    "@tanstack/react-table": "8.21.3",
    "axios": "1.17.0",
    "axios-retry": "4.5.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "jsonwebtoken": "9.0.3",
    "pino": "9.9.0",
    "pino-pretty": "13.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.6.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.1",
    "npm-run-all2": "7.0.2",
    "rimraf": "6.0.1",
    "shx": "0.4.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
