{
  "name": "node-js-demo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js/TypeScript demo marketplace app for MoySklad",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json && npm run build:assets",
    "build:assets": "mkdir -p dist && rm -rf dist/views dist/public && cp -R src/views dist/views && mkdir -p dist/public && cp -R public/assets dist/public/assets",
    "start": "node dist/server.js",
    "cli:generate-jwt": "tsx src/cli-utils/generate-jwt.ts",
    "cli:generate-descriptor": "tsx src/cli-utils/generate-descriptor.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:test && npm test",
    "clean:data": "rimraf tmp/data && shx mkdir -p tmp/data && shx chmod 700 tmp/data"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "axios": "1.15.2",
    "axios-retry": "4.5.0",
    "dotenv": "17.4.2",
    "ejs": "5.0.2",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "jsonwebtoken": "9.0.3",
    "pino": "9.9.0",
    "pino-pretty": "13.1.2"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.6.0",
    "rimraf": "6.0.1",
    "shx": "0.4.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
