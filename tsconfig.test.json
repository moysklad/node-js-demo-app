{
  "extends": "./backend/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "backend/src/**/*.ts",
    "frontend/src/lib/**/*.ts",
    "frontend/src/pages/**/lib/**/*.ts",
    "frontend/src/pages/**/types.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
